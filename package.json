{
  "name": "artifactmap",
  "version": "0.1.0",
  "description": "Local-first CLI that inventories generated artifacts and repository hygiene evidence.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "artifactmap": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/artifactmap.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/artifactmap/issues"
  },
  "homepage": "https://github.com/rogerchappel/artifactmap#readme",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "npm run build && npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke",
    "lint": "npm run check"
  },
  "keywords": [
    "artifacts",
    "cli",
    "gitignore",
    "repository-hygiene",
    "generated-files"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2"
  }
}
